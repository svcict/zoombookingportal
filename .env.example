# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Zoom REST API Configuration - two rotating Server-to-Server OAuth apps.
# Meetings alternate between Account A and Account B so overlapping bookings
# never collide with a single license's concurrent-meeting limit.
# See README.md "Zoom API Setup" for how to create these in the Zoom Marketplace.
# Leave both unset to run in demo mode (mock meeting data, no real Zoom calls).
ZOOM_ACCOUNT_A_ID=
ZOOM_ACCOUNT_A_CLIENT_ID=
ZOOM_ACCOUNT_A_CLIENT_SECRET=
ZOOM_ACCOUNT_A_USER_ID=
ZOOM_ACCOUNT_A_LABEL=Zoom Account A

ZOOM_ACCOUNT_B_ID=
ZOOM_ACCOUNT_B_CLIENT_ID=
ZOOM_ACCOUNT_B_CLIENT_SECRET=
ZOOM_ACCOUNT_B_USER_ID=
ZOOM_ACCOUNT_B_LABEL=Zoom Account B

# Zoom Event Webhook Listener - the "Secret Token" shown on your Zoom app's
# Feature > Event Subscriptions page. Required to verify that incoming
# POST /api/zoom/webhooks requests genuinely came from Zoom (and to
# complete Zoom's one-time endpoint URL validation). See README.md.
ZOOM_WEBHOOK_SECRET_TOKEN=

# Microsoft 365 / Office 365 / Azure Entra ID Configuration
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_GRAPH_SCOPES=
MICROSOFT_ORGANIZATION_DOMAIN=
MICROSOFT_PRIMARY_USER_EMAIL=

# Supabase Database & Authentication Configuration
# Found in: Supabase Project Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed to sign in WITHOUT a real password,
# by looking them up directly in the `profiles` table - for demoing the app
# with seeded accounts that were never given a real Supabase Auth password.
# Only emails listed here get this; self-registered accounts never do, even
# though they also get a profiles row. Leave unset to disable entirely.
# Example: DEMO_LOGIN_EMAILS=sarah.jenkins@zoompartner.com,alex.rivera@zoompartner.com
DEMO_LOGIN_EMAILS=

# Signs the short-lived tokens issued to DEMO_LOGIN_EMAILS accounts above.
# Optional - if unset, a random secret is generated per server process
# (meaning a restart simply requires those demo accounts to log back in).
# Set this only if you need demo sessions to survive a restart.
DEMO_TOKEN_SECRET=
